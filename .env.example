# ===== LITELLM GATEWAY (multi-provider proxy) =====
# When USE_LITELLM=true, AI text/streaming calls route through the LiteLLM
# proxy (see litellm/README.md), which handles provider selection, retries and
# cross-provider fallbacks. If disabled or unreachable, the app falls back to
# its native OpenAI/Gemini/GitHub provider chain automatically.
USE_LITELLM=false
LITELLM_BASE_URL=http://localhost:4000/v1
# The app authenticates with a scoped VIRTUAL key (create one in the Admin UI →
# Virtual Keys, or via /key/generate, ideally with a budget/rate limit). The
# proxy's master/root key belongs ONLY in litellm/.env.litellm, not here.
LITELLM_API_KEY=sk-your-virtual-key
# (Optional) Fallback only. If LITELLM_API_KEY is unset, the gateway will use
# this master key — but prefer leaving it blank and using a virtual key.
# LITELLM_MASTER_KEY=

# ===== SOCIAL LISTENING =====
