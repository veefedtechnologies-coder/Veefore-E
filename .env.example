SOCIAL_LISTENING_POST_CAP=150
# How many top posts to pull comments from (Reddit + Hacker News).
SOCIAL_LISTENING_COMMENT_POST_CAP=15
# Comments fetched per post.
SOCIAL_LISTENING_COMMENTS_PER_POST=40
# Set to 'true' to route AI analysis through the OpenAI Batch API for a 50%
# provider discount (requires OPENAI_API_KEY). Falls back to synchronous
# batching automatically if the batch can't finish in time.
SOCIAL_LISTENING_USE_BATCH_API=false
# Background refresh: periodically re-sync workspaces via the Batch API so the
# user's click lands on already-cached (free) data. Uses the Batch API path.
SOCIAL_LISTENING_BG_REFRESH=false
SOCIAL_LISTENING_BG_REFRESH_INTERVAL_MS=21600000
SOCIAL_LISTENING_BG_STALE_MS=21600000
SOCIAL_LISTENING_BG_MAX_PER_TICK=3
# How long an AI analysis cache entry stays valid (default 14 days).
SOCIAL_LISTENING_CACHE_TTL_MS=1209600000
# Dedicated debug log file at logs/social-listening-debug.log (set 'false' to disable).
SOCIAL_LISTENING_DEBUG=true
# Per-batch AI timeout (ms) — if one analysis call hangs, fall back so the sync
# keeps moving instead of freezing.
SOCIAL_LISTENING_BATCH_TIMEOUT_MS=60000

