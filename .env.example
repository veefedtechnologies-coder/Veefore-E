# Storage backend selection:
#  - Leave AWS_ACCESS_KEY_ID unset (or USE_LOCAL_STORAGE=true) → local disk
#    (dev only; NOT durable, NOT multi-instance safe).
#  - Set AWS creds below → durable object storage (S3 / Cloudflare R2 / any
#    S3-compatible provider). Recommended for production.
# USE_LOCAL_STORAGE=false

# AWS S3 / S3-compatible object storage (recommended for production).
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=demo-uploads-bucket

# Keep the bucket PRIVATE and serve images through the authenticated proxy
# GET /api/chat/image/:assetId. Leave S3_PUBLIC_READ off (false).
# S3_PUBLIC_READ=false

# Image delivery mode for the authenticated proxy:
#   stream     (default) = server pipes bytes through itself (works everywhere)
#   redirect             = after auth, 302 to a short-lived pre-signed S3 URL so
#                          bytes flow S3 → browser directly (offloads server
#                          bandwidth; bucket stays private).
#   cloudfront           = after auth, 302 to a short-lived CloudFront SIGNED URL
#                          so bytes flow from the CDN edge (fastest globally,
#                          cheapest egress; bucket stays private via OAC). Best
#                          for production. Requires the CLOUDFRONT_* vars below.
# IMAGE_DELIVERY=cloudfront
# Signed-URL lifetime in seconds for redirect/cloudfront mode, clamped to [60, 86400].
# IMAGE_SIGNED_URL_TTL=3600

# CloudFront signed-URL delivery (only when IMAGE_DELIVERY=cloudfront). The
# distribution fronts the PRIVATE bucket via Origin Access Control and requires a
# trusted key group. Generate an RSA key pair, upload the PUBLIC key to CloudFront
# (Key management → Public keys), and put its ID + the PRIVATE key here. No AWS
# access key is used for signing. The private key uses literal \n for newlines.
# CLOUDFRONT_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=K1ABCD2EFGH3
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Serve object URLs from a CDN / custom domain / R2 public bucket (no trailing slash).
# When set, this is used to build image URLs instead of the raw S3 endpoint.
# S3_PUBLIC_BASE_URL=https://cdn.veefore.com

# Cloudflare R2 (or any S3-compatible provider): set the endpoint and keep the
# AWS_* vars above (R2 issues S3 access keys). R2 has ZERO egress fees and does
# NOT use per-object ACLs — configure public access on the bucket + set
# S3_PUBLIC_BASE_URL to your R2 public/custom domain.
# AWS_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Server's own reachable origin, used only to fetch its OWN locally-stored files
# when serving via a relative /uploads path (dev). Defaults to http://127.0.0.1:$PORT.
# Not needed once object storage (S3/R2) returns absolute URLs.
# INTERNAL_SELF_URL=http://127.0.0.1:3000

