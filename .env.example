# ===== VEEGPT USAGE CONTROL (VGU) =====
# Every AI-producing path runs through one engine (server/services/veegpt-metering.ts).
# Nothing below is required — all values have safe defaults in
# server/config/veegpt-vgu.config.ts. They exist so limits can be retuned in
# production without a deploy.

# How the provider-boundary guard reacts to an AI call made OUTSIDE a metered
# context (i.e. a code path that would bypass the quota):
#   warn    log at error level and allow it   (default; safe to deploy)
#   strict  throw before the provider is called (use in CI, and in production
#           once the warn logs are clean)
#   off     allow silently                    (escape hatch only)
VGU_ENFORCEMENT=warn

# The provider cost (USD) that equals exactly 1 VGU. Raising it makes everything
# cost fewer VGU. Derived from a measured gpt-4o-mini reference turn.
# VEEGPT_VGU_ANCHOR_USD=0.0011

# Rolling burst window length, in hours (default 5).
# VEEGPT_SESSION_WINDOW_HOURS=5

# Per-plan budgets. -1 means unlimited. <PLAN> is FREE|CREATOR|PRO|BUSINESS|ENTERPRISE.
# VEEGPT_5H_VGU_FREE=15
# VEEGPT_MONTHLY_VGU_CREATOR=1200
# VEEGPT_RPM_PRO=40
# VEEGPT_CONCURRENCY_PRO=4
# Fraction of a pooled (Business) budget one seat may use, as a percentage.
# VEEGPT_SEAT_SHARE_BUSINESS=40

# Per-tier sub-budgets, so one expensive model cannot eat a whole plan.
# VEEGPT_TIER_VGU_PRO_PREMIUM=2500
# VEEGPT_TIER_REQUESTS_FREE_PREMIUM=5

# Per-feature period ceilings. Dots become underscores, upper-cased. Optionally
# suffix with a plan. Negative means unlimited. Use these to clamp a runaway cost.
# VEEGPT_FEATURE_CAP_VEEGPT_DEEP_RESEARCH_PRO=2000
# Global ceiling for the anonymous landing-page caption demo (it has no user to
# charge, so this is its only spend limit besides per-IP rate limiting).
# VEEGPT_FEATURE_CAP_LANDING_DEMO_CAPTION=3000
# VEEGPT_FEATURE_CAP_AUTOMATION_INTENT_PRO=1000

# How long an unreconciled reservation is held before the sweeper reclaims it.
# VEEGPT_RESERVATION_TTL_SEC=900

# ----- Concurrency (spec §31, §39) -----
# Simultaneous AI operations per USER. High VGU allowances must never become
# unlimited simultaneous provider calls, so this is enforced independently of
# every budget — Enterprise is unlimited on VGU and still bounded here.
# VEEGPT_CONCURRENCY_PRO=4
# Simultaneous AI operations for a whole POOLED WORKSPACE. A per-seat limit is
# not a team bound: 10 Business seats at 10 each is 100 concurrent provider
# calls, not the 10 the spec allows. -1 = no workspace bound (single-seat plans).
# VEEGPT_WS_CONCURRENCY_BUSINESS=10

# ----- Abuse protection (spec §32) -----
# Behavioural detection, separate from the budget: the budget decides what a user
# may SPEND, this decides whether they are behaving like a script. Eight signals
# are combined; no single signal can ever trigger an action.
#   on   collect signals and compute an action  (default)
#   off  collect nothing
VGU_ABUSE_DETECTION=on
# Whether a computed action is APPLIED or only recorded. Off by default on
# purpose: heuristics need real traffic before they are allowed to refuse anyone.
# Watch for `vgu-abuse: signals detected` in the logs, confirm the verdicts look
# right, then turn this on.
VGU_ABUSE_ENFORCE=off
# Signal thresholds. Raise these if legitimate power users are being flagged.
# VGU_ABUSE_MIN_SAMPLE=20            requests before a user is scored at all
# VGU_ABUSE_DUP_LIMIT=10             identical prompts per hour
# VGU_ABUSE_CONTEXT_CHARS=400000     prompt size that counts as abnormal
# VGU_ABUSE_CONC_BLOCKS=20           concurrency refusals per hour
# VGU_ABUSE_NEW_ACCOUNT_REQUESTS=100 volume from an account under a day old

# ----- Failure handling, retries and fan-out (spec §35–§37) -----
# Every AI operation is bounded three ways, all read from the feature registry in
# server/config/veegpt-vgu.config.ts. These are independent on purpose: a charge
# cap still lets a loop keep CALLING the provider, and a call cap still lets a few
# enormous calls run up a bill.
#
#   maxVGUPerRequest  caps the CHARGE      (Block 3)
#   maxProviderCalls  caps the CALLS       (below)
#   timeoutMs         caps the WALL CLOCK
#   maxRetries        caps the ATTEMPTS
#
# Maximum provider calls one request of a feature may make. Dots become
# underscores, upper-cased. Negative means unbounded. Tighten this the moment a
# runaway appears; loosen it if a legitimate job needs more room.
# VEEGPT_FEATURE_CALLS_VEEGPT_DEEP_RESEARCH=25
# VEEGPT_FEATURE_CALLS_VIDEO_GENERATION=25
# VEEGPT_FEATURE_CALLS_VEEGPT_CHAT=30
#
# Retries are provider-aware: 429/5xx/timeouts/connection failures are retried
# with exponential backoff and jitter, and a provider's own Retry-After wins over
# our curve. 4xx, content-policy refusals and our own quota decisions are NEVER
# retried — they would fail identically and every attempt costs money.
# All attempts of one logical request share ONE reservation, so a retry is
# reconciled into a single charge rather than billed again.

# ----- Deep Research / Autopilot governance (spec §22, §23) -----
# Both run in their OWN nested reservation, so they are governed by their own
# ceilings rather than inheriting the chat turn's. Every ceiling is tunable without
# a deploy; negative or 0 means unbounded.
#
# How many runs of one feature a user may have in flight. Deep Research is 1 —
# each job makes many provider calls, so one at a time is the point.
# VEEGPT_FEATURE_CONCURRENCY_VEEGPT_DEEP_RESEARCH=1
# VEEGPT_FEATURE_CONCURRENCY_VEEGPT_AUTOPILOT=1
# Wall-clock budget per job, in milliseconds.
# VEEGPT_FEATURE_TIMEOUT_VEEGPT_DEEP_RESEARCH=480000
# VEEGPT_FEATURE_TIMEOUT_VEEGPT_AUTOPILOT=900000
# Monthly allowance per plan (see VEEGPT_FEATURE_CAP_* above for the pattern).
# VEEGPT_FEATURE_CAP_VEEGPT_DEEP_RESEARCH_PRO=2000
# VEEGPT_FEATURE_CAP_VEEGPT_AUTOPILOT_PRO=2000
#
# The per-job VGU ceiling (250 research / 400 autopilot) lives in the feature
# registry rather than the environment: it is the last line of defence against an
# uncontrolled provider bill, so changing it should be a reviewed code change.

# ----- UX / structured refusals (spec §28, §42, §43) -----
# No new configuration. Behaviour, documented so it isn't mistaken for a bug:
#  • An explicit Premium/Ultra selection refused for quota returns
#    MODEL_QUOTA_EXHAUSTED with suggestedTier:"cheap" — the server NEVER swaps
#    models. The client shows "Premium AI capacity reached. Continue with
#    VeeGPT Fast?" and only resends (with body { continueWithFast: true }) after
#    the user clicks. That resend runs on the Light model for that one message;
#    the stored AI Configuration selection is untouched.
#  • GET /api/chat/limits returns a plain-language `notice` (§42, silent below
#    70%) and per-feature `features[]` lines (§44). No provider pricing is exposed.

# VeeGPT context composer tuning: VEEGPT_CTX_* vars (see veegpt-context.config.ts).
# The composer is always on; there is no enable/disable flag.
# Verification recorder (default off): when true, each VeeGPT chat turn appends a
# "compose" line + a "usage" line (real provider tokens incl. reasoning) to
# logs/veegpt-context-debug.jsonl. VEEGPT_CTX_DEBUG_TEXT also stores a truncated
# message preview (default off for privacy).
VEEGPT_CTX_DEBUG=false
VEEGPT_CTX_DEBUG_TEXT=false

# ── VeeGPT native image capability (Gemini) ──────────────────────────────────
# The image capability reuses GOOGLE_API_KEY (or GEMINI_API_KEY). The model IDs
# below are OPTIONAL overrides — defaults live in server/config/veegpt-image.config.ts.
# Default is gemini-2.5-flash-image ("Nano Banana"), the generally-available
# native image model that works with a standard Google API key. Override these
# only when your key is allowlisted for a newer/preview image model.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL_PREMIUM=gemini-2.5-flash-image
# If Google 404s a pinned image id on your key ("not available to new users"),
# the service auto-retries this comma-separated fallback list (first available wins).
# GEMINI_IMAGE_MODEL_FALLBACKS=gemini-2.5-flash-image,gemini-2.5-flash-image-preview,gemini-3-pro-image-preview

# ── VeeGPT media UNDERSTANDING model (video / PDF / HEIC vision) ──────────────
# When a chat turn attaches a video/PDF/HEIC, the request is routed to Gemini
# (only Gemini reads those). This MUST be a CURRENT model id — Google retires old
# generations for new keys (e.g. gemini-2.5-flash now 404s "no longer available
# to new users — use gemini-3.6-flash"). A retired id 404s and cascades into the
# fallback chain, which then rate-limits the key. Keep this on a live flash id.
# GEMINI_MEDIA_MODEL=gemini-3.6-flash
# Ordered fallbacks if the primary is unavailable (404) or overloaded (503):
# GEMINI_MEDIA_FALLBACKS=gemini-3.6-flash,gemini-3.7-flash,gemini-flash-latest

# ── VeeGPT generative VIDEO capability (Google: Veo + Gemini Omni Flash) ──────
# Track 3 GENERATIVE video edits reuse the SAME Google key as the image
# capability (GEMINI_IMAGE_API_KEY / GOOGLE_API_KEY / GEMINI_API_KEY /
# GOOGLE_GENAI_API_KEY). The model IDs below are OPTIONAL overrides — defaults
# live in server/features/video-editor/services/generative-video.service.ts.
# Veo powers text-to-video / image-to-video generation + extension:
# GEMINI_VEO_MODEL=veo-3.1-generate-preview
# Gemini Omni Flash powers editing existing clips (object removal, background
# replace, generative edits):
# GEMINI_OMNI_VIDEO_MODEL=gemini-omni-flash-preview

# ── Generative edit localization (cheap pre-pass before Omni) ────────────────
# When an edit-type generative op (object removal / background replace /
# generative edit) is requested WITHOUT an explicit time range, a cheap
# localization pre-pass samples low-res frames and asks a cheap Gemini vision
# model where the edit applies, so only the detected windows go through the
# expensive Omni pass. If localization is uncertain it silently falls back to
# editing the whole clip. Every var below is OPTIONAL — defaults are safe.
# Cheap Gemini vision model id used for localization (env-overridable):
# GEMINI_LOCALIZER_MODEL=gemini-2.5-flash
# Frame sampling rate in frames per second (invalid/<=0 falls back to default):
# LOCALIZER_SAMPLE_FPS=1
# Downscale target height in px for sampled frames (scale=-2:H):
# LOCALIZER_FRAME_HEIGHT=360
# Max number of localization windows spliced back into the timeline:
# LOCALIZER_MAX_WINDOWS=3
# Confidence floor (0..1); candidate ranges below this are discarded:
# LOCALIZER_MIN_CONFIDENCE=0.3

# ── Generative video daily budget PER WORKSPACE (secondary guardrail) ────────
# The server resolves ONE shared Google key for generative video (Omni/Veo), and
# Google meters its daily generate-request quota PER API KEY — so a single heavy
# workspace can exhaust the pool for everyone. Setting this to a positive integer
# caps how many generative operations ONE workspace may start per UTC day
# (Redis-backed counter, key veditor:genbudget:<workspaceId>:<YYYY-MM-DD>).
# When over budget the turn returns an honest "daily limit reached, credits were
# NOT charged" message with no provider call; deterministic edits keep working.
# DEFAULT: unset (or 0 / negative / non-numeric) = DISABLED, no gating and no
# Redis usage. The check also fails OPEN if Redis is unavailable.
# VIDEO_EDITOR_GENERATIVE_DAILY_LIMIT_PER_WORKSPACE=0

# ── Video Editor debug recorder (default off) ────────────────────────────────
# When true, each chat-driven video edit turn appends one JSON line per stage
# (intent → plan → each executed step → localization decision → outcome) to
# logs/video-editor-debug.jsonl, all sharing a per-turn traceId. Never affects
# the edit and never throws. VIDEO_EDITOR_DEBUG_TEXT also stores a truncated
# copy of the edit instruction (default off for privacy).
VIDEO_EDITOR_DEBUG=false
VIDEO_EDITOR_DEBUG_TEXT=false

# ── Video Editor FFmpeg encoder policy (render speed) ────────────────────────
# Every deterministic render (trim/grade/caption burn-in/assembly/export) resolves
# its video encoder from ONE policy module. When the bundled ffmpeg provides
# `h264_videotoolbox` (macOS/Apple Silicon) it is used automatically: ~3x faster
# wall time and ~10x less CPU than libx264 at equivalent visual quality. On Linux
# production (no VideoToolbox) the policy transparently returns libx264. Every var
# below is OPTIONAL — defaults are safe on every platform.
#
# Force the SOFTWARE encoder even where hardware exists. Hardware encoders are not
# bit-reproducible, so set this to true when you need byte-for-byte identical
# output for identical input (determinism audits / golden-file comparisons).
# VIDEO_EDITOR_FORCE_SOFTWARE_ENCODE=false
# libx264/libx265 `-preset` used on the software path. Default `veryfast` (was
# `medium`, roughly 2x slower for no meaningful quality gain at crf 18). Invalid
# values fall back to the default. Valid: ultrafast superfast veryfast faster fast
# medium slow slower veryslow placebo
# VIDEO_EDITOR_SOFTWARE_ENCODE_PRESET=veryfast
# VideoToolbox constant-quality value (`-q:v`, integer 1..100, higher = better).
# Default 55 — visually equivalent to libx264 crf 18 on 1080x1920 social video and
# a SMALLER file. Invalid / out-of-range values fall back to the default.
# VIDEO_EDITOR_HARDWARE_ENCODE_QUALITY=55
# `-threads` cap for the SOFTWARE path only (0..64; 0 = omit the flag and let
# ffmpeg use one thread per core, which is the default and right for a dedicated
# render worker). On a SHARED server set this to a fraction of the box (e.g. 4) so
# a software fallback cannot peg every core and starve the API process.
# VIDEO_EDITOR_SOFTWARE_ENCODE_THREADS=0

# ── Video ingestion FFmpeg/FFprobe timeouts (prevent stuck "Analyzing…") ──────
# When a video is attached in chat it is probed + given preview artifacts
# (proxy/thumbnail/waveform) synchronously. These hard timeouts (ms) SIGKILL a
# stuck/very-slow FFmpeg/FFprobe so the turn can never hang forever. Preview
# stages are best-effort: on timeout they are skipped and editing still proceeds
# (only the probed duration is required).
# INGEST_PROBE_TIMEOUT_MS=30000
# INGEST_PREVIEW_TIMEOUT_MS=90000

# ── Chat attachment upload timeout (prevent stuck "Uploading your video…") ────
# POST /api/chat/attachments/upload streams the file to object storage (S3). On a
# slow/stalled connection this could hang the "Uploading your video…" spinner
# forever with no server log. This hard cap (ms) fails the upload loudly (HTTP
# 504) instead. Start/ok/timeout are logged to logs/veegpt-debug.log. Default 120s.
# CHAT_ATTACHMENT_UPLOAD_TIMEOUT_MS=120000

# ── Video Editor SSRF allowlist (external/provider media fetches) ─────────────
# The Video Editor fetches external or provider-supplied media URLs ONLY through
# an SSRF guard: the destination host must be on this allowlist AND must not
# resolve to a private/loopback/link-local/internal address (Req 19.6, 19.7).
# Comma/whitespace-separated hosts. A plain host matches exactly; a leading-dot
# host (".example.com") matches the domain and any subdomain. When unset, NOTHING
# is fetchable (fail-closed).
# VIDEO_EDITOR_MEDIA_ALLOWLIST=.googleapis.com,storage.googleapis.com,.veefore-cdn.com
# Permitted URL schemes for those fetches (defaults to https only).
# VIDEO_EDITOR_MEDIA_ALLOWED_SCHEMES=https

# =============================================================================
# SECURITY HARDENING (spec: .kiro/specs/production-security-hardening)
# =============================================================================
# These controls are driven by EXPLICIT configuration, never inferred from
# NODE_ENV. This matters because the production host runs NODE_ENV=development
# behind an HTTPS tunnel — the previous `isProduction` gates silently disabled
# HSTS, CSP and clickjacking protection on live traffic.
#
# Anything left unset uses a safe default, so an empty config is still protected.

# --- Transport / cookies -----------------------------------------------------
# Force the Secure cookie attribute on/off. Leave unset to auto-detect from
# whether FRONTEND_URL/APP_ORIGIN is https (correct for the tunnel deployment).
# COOKIE_SECURE=true

# Cookie scope. Must cover the app's hostname or the browser rejects the cookie
# (validated at startup). Leave unset for a host-only cookie (tightest scope).
# COOKIE_DOMAIN=app.veefore.com

# --- HSTS (Requirement 2) ----------------------------------------------------
# Enabled automatically whenever the app is served over HTTPS.
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=63072000
#
# WARNING: both of the following are effectively IRREVERSIBLE for the duration of
# max-age. Once a browser or the preload list records them, every subdomain must
# serve valid HTTPS or it becomes unreachable. Default OFF; opt in knowingly.
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# SECURITY_HSTS_PRELOAD=false

# --- Content-Security-Policy (Requirement 3) ---------------------------------
# CSP is ON but REPORT-ONLY by default: it reports violations without blocking,
# because a first enforcing CSP very often blocks a legitimate resource and
# blanks the page. Review the reports, then set SECURITY_CSP_ENFORCE=true.
# SECURITY_CSP_ENABLED=true
# SECURITY_CSP_ENFORCE=false
# SECURITY_CSP_REPORT_URI=/api/security/csp-report
#
# Extra allowed origins (comma-separated) for third parties not in the baseline.
# SECURITY_CSP_CONNECT_SRC=https://api.example.com
# SECURITY_CSP_SCRIPT_SRC=
# SECURITY_CSP_IMG_SRC=
# SECURITY_CSP_STYLE_SRC=
# SECURITY_CSP_FONT_SRC=
# SECURITY_CSP_MEDIA_SRC=
#
# The embedded Vite dev pipeline needs inline/eval scripts and websocket HMR.
# Auto-enabled while the dev server is in use; set false for a built bundle.
# SECURITY_CSP_ALLOW_DEV_INLINE=true

# --- Clickjacking (Requirement 4) --------------------------------------------
# sameorigin (default) | deny | off
# The old code disabled frameguard AND stripped X-Frame-Options for a Replit
# iframe that no longer hosts this app. Set to `off` ONLY if you have a real
# embedding requirement; prefer listing the embedding origin below instead.
# SECURITY_FRAME_POLICY=sameorigin
# SECURITY_FRAME_ANCESTORS=https://trusted-partner.example.com

# --- CORS (Requirement 5) ----------------------------------------------------
# Comma-separated allow-list. Unset defaults to SAME-ORIGIN ONLY. A `*` value is
# ignored, because a wildcard combined with credentials is never valid.
# CORS_ORIGIN=https://app.veefore.com

# --- CSRF (Requirement 8) ----------------------------------------------------
# Signed double-submit cookie. Requires SESSION_SECRET (>= 32 chars).
#
# Defaults to REPORT-ONLY: it logs what enforcement WOULD reject without
# blocking, so the client can be updated to echo the X-CSRF-Token header first.
# Watch for `[csrf] REPORT-ONLY would reject` lines, fix the callers, then set
# SECURITY_CSRF_ENFORCE=true.
# SECURITY_CSRF_ENABLED=true
# SECURITY_CSRF_ENFORCE=false

# --- Session lifetime (Requirement 7) ----------------------------------------
# Idle = max gap between requests (sliding). Absolute = max total age from the
# ORIGINAL authentication; activity deliberately does NOT extend it, otherwise a
# continuously active session would never expire.
# The absolute age is read from the token's signed auth_time/iat claim, so it cannot
# be forged or extended by the client.
# SECURITY_SESSION_LIFETIME_ENABLED=true
# SECURITY_SESSION_IDLE_SECONDS=604800        # 7 days
# SECURITY_SESSION_ABSOLUTE_SECONDS=2592000   # 30 days

# --- Credential endpoint rate limits (Requirement 9) -------------------------
# Two buckets, because the traffic shapes differ by an order of magnitude:
#   verification (/signin, /signup, ...)      → a human typing; tight.
#   maintenance  (/session-login, /refresh)   → fired automatically on page loads;
#                                               generous, or you get false 429s.
# SECURITY_CREDENTIAL_RATE_LIMIT_ENABLED=true
# SECURITY_CREDENTIAL_RATE_LIMIT=10   # per minute per IP, verification
# SECURITY_SESSION_RATE_LIMIT=120     # per minute per IP, maintenance
