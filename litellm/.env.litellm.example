# =============================================================================
# Environment for the LiteLLM proxy container (docker-compose.yml -> env_file).
# Copy to `.env.litellm` and fill in real values. Do NOT commit .env.litellm.
# =============================================================================

# Bearer key every inbound request must present. MUST start with "sk-".
# The Node app must send this same value as LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-secret

# ---- Provider credentials (only set the ones you use) ----
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
PERPLEXITY_API_KEY=
