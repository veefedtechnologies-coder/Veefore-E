{
  "buildCommand": "npm run client:build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://veefore-e-production.up.railway.app/__/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}